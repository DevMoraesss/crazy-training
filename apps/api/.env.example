# Copie para apps/api/.env. Na Railway, DATABASE_URL vem do serviço Postgres e PORT é definido por ela.
#DATABASE_URL=localhost:1234/nomedobanco
#PORT=1234

# IA opcional: configure somente no servidor. Nunca use EXPO_PUBLIC para a chave.
# Primeira integração disponível: OpenAI Responses API. Escolha um modelo com JSON mode.
# COACH_PROVIDER=openai
# COACH_MODEL=<modelo escolhido na sua conta>
# OPENAI_API_KEY=<sua chave>
# As rotas /coach estão limitadas a clientes locais até existir autenticação.
