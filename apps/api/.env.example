# Copie para apps/api/.env. Na Railway, DATABASE_URL vem do serviço Postgres e PORT é definido por ela.
#DATABASE_URL=postgres://usuario:senha@localhost:5432/crazy_training
#PORT=3000

# Login pessoal (a conta é criada na primeira inicialização). Senha com 12 caracteres ou mais.
#ACCOUNT_EMAIL=voce@exemplo.com
#ACCOUNT_PASSWORD=<senha do app>
# Em produção: a URL da Vercel. Vazio = só localhost:8081/8083.
#WEB_ORIGINS=https://crazy-training.vercel.app

# IA opcional (API do Claude): configure somente no servidor. Nunca use EXPO_PUBLIC para a chave.
#ANTHROPIC_API_KEY=<sua chave da API do Claude>
# Modelo padrão: claude-opus-5-5. Só mude se quiser outro.
#AI_MODEL=claude-opus-5-5
